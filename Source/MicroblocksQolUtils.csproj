<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Celeste.Mod.MicroblocksQolUtils</RootNamespace>
    <AssemblyName>MicroblocksQolUtils</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <CelesteRoot Condition="'$(CelesteRoot)' == '' and '$(CELESTE_ROOT)' != ''">$(CELESTE_ROOT)</CelesteRoot>
    <CelesteRoot Condition="'$(CelesteRoot)' == '' and '$(OS)' == 'Windows_NT'">C:\SteamLibrary\steamapps\common\Celeste</CelesteRoot>
    <CelesteRoot Condition="'$(CelesteRoot)' == ''">$(MSBuildThisFileDirectory)../lib-stripped</CelesteRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="YamlDotNet"><HintPath>$(CelesteRoot)/YamlDotNet.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Celeste"><HintPath>$(CelesteRoot)/Celeste.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="FNA"><HintPath>$(CelesteRoot)/FNA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MMHOOK_Celeste"><HintPath>$(CelesteRoot)/MMHOOK_Celeste.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(CelesteRoot)/Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoMod.RuntimeDetour"><HintPath>$(CelesteRoot)/MonoMod.RuntimeDetour.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MonoMod.Utils"><HintPath>$(CelesteRoot)/MonoMod.Utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Drawing.Common"><HintPath>$(CelesteRoot)/System.Drawing.Common.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="MaterialSymbols\Rounded\*.svg" LogicalName="Celeste.Mod.MicroblocksQolUtils.MaterialSymbols.Rounded.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
